Algoritmo ejercicio1
	
	Escribir "dime un numero"
	Leer primerNumero
	Escribir "dime otro numero"
	Leer segundoNumero
	
	Si primerNumero > segundoNumero Entonces
		Escribir "el primero es mayor : " primerNumero
	SiNo
		Si primerNumero < segundoNumero Entonces
			Escribir "el segundo es mayor : " segundoNumero
		SiNo
			Escribir "son iguales"
		Fin Si
	Fin Si
	
	
FinAlgoritmo
